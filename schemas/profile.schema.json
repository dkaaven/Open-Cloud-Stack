{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud Stack Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "modules"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}
