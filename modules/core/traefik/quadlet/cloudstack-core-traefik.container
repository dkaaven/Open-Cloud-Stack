[Unit]
Description=Cloud Stack Traefik

[Container]
ContainerName=cloudstack-core-traefik
Image=docker.io/library/traefik@sha256:9c3b91d5fb7770853ca5c1124a23c34bf2d9b47ffaebeab2614cbaf410dcb2ac

Network=cloudstack-edge.network

PublishPort=80:80
PublishPort=443:443

Volume=/etc/cloudstack/traefik:/etc/traefik:ro

HealthCmd=traefik healthcheck
HealthInterval=30s

NoNewPrivileges=true
ReadOnly=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
