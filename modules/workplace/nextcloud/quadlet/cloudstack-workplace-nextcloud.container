[Unit]
Description=Cloud Stack Nextcloud
Requires=cloudstack-data-postgres.service
Requires=cloudstack-data-valkey.service
After=cloudstack-data-postgres.service
After=cloudstack-data-valkey.service

[Container]
ContainerName=cloudstack-workplace-nextcloud
Image=docker.io/library/nextcloud@sha256:8e5f49801db0cf4659b3089ce1917728023bb8cba7f93731f2abbdfe3a18df0a

Network=cloudstack-edge.network
Network=cloudstack-data.network

Volume=cloudstack-workplace-nextcloud-data.volume:/var/www/html
Volume=/etc/cloudstack/modules/workplace/nextcloud/config:/etc/cloudstack-nextcloud:ro
Volume=/etc/cloudstack/modules/workplace/nextcloud/config/hooks/before-starting:/docker-entrypoint-hooks.d/before-starting:ro

EnvironmentFile=/etc/cloudstack/modules/workplace/nextcloud/config/runtime.env

Secret=nextcloud-db-password,target=nextcloud-db-password
Secret=nextcloud-admin-password,target=nextcloud-admin-password
Secret=valkey-password,target=valkey-password,uid=33,gid=33,mode=0440

HealthCmd=/etc/cloudstack-nextcloud/healthcheck.sh
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=120s

NoNewPrivileges=true
StopTimeout=30

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=600
TimeoutStopSec=60
